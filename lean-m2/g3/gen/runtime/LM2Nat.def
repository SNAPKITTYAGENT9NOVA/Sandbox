DEFINITION MODULE LM2Nat;
(* LEAN-M2-CC-001 MathIR runtime (v1 core, v2/v3 builtins, v4 ℤ): checked LONGCARD operations with Lean ℕ semantics.
   Each returns TRUE on overflow (r NOT written), FALSE otherwise.
   Sub truncates at 0; x DIV 0 = 0; x MOD 0 = x; 0^0 = 1. Hand-written, fixed. *)
PROCEDURE Add (a, b: LONGCARD; VAR r: LONGCARD) : BOOLEAN;
PROCEDURE Mul (a, b: LONGCARD; VAR r: LONGCARD) : BOOLEAN;
PROCEDURE Sub (a, b: LONGCARD; VAR r: LONGCARD) : BOOLEAN;
PROCEDURE Div (a, b: LONGCARD; VAR r: LONGCARD) : BOOLEAN;
PROCEDURE Mod (a, b: LONGCARD; VAR r: LONGCARD) : BOOLEAN;
PROCEDURE Pow (a, e: LONGCARD; VAR r: LONGCARD) : BOOLEAN;
(* MathIR v2 builtins, Lean/Mathlib semantics (same algorithms as lm2_nat.h) *)
PROCEDURE Min (a, b: LONGCARD) : LONGCARD;
PROCEDURE Max (a, b: LONGCARD) : LONGCARD;
PROCEDURE Gcd (a, b: LONGCARD; VAR r: LONGCARD) : BOOLEAN;      (* gcd 0 0 = 0 *)
PROCEDURE Lcm (a, b: LONGCARD; VAR r: LONGCARD) : BOOLEAN;      (* lcm 0 b = 0 *)
PROCEDURE Fact (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;        (* 21! overflows *)
PROCEDURE Choose (n, k: LONGCARD; VAR r: LONGCARD) : BOOLEAN;   (* 0 if k > n *)
PROCEDURE Sqrt (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;        (* floor *)
PROCEDURE MinFac (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;      (* minFac 0 = 2, minFac 1 = 1 *)
PROCEDURE IsPrime (n: LONGCARD) : LONGCARD;                     (* 1 / 0 *)
PROCEDURE Dvd (a, b: LONGCARD) : LONGCARD;                      (* 0 ∣ b iff b = 0; 1 / 0 *)
(* MathIR v3 builtins, Lean/Mathlib semantics (same algorithms as lm2_nat.h) *)
PROCEDURE Fib (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;         (* fib 94 overflows *)
PROCEDURE Log (b, n: LONGCARD) : LONGCARD;                      (* 0 if b <= 1 or n < b *)
PROCEDURE Log2 (n: LONGCARD) : LONGCARD;                        (* Log(2, n) *)
PROCEDURE PadicVal (p, n: LONGCARD) : LONGCARD;                 (* 0 if p <= 1 or n = 0 *)
PROCEDURE BigOmega (n: LONGCARD) : LONGCARD;                    (* prime factors with multiplicity *)
PROCEDURE DigSum (b, n: LONGCARD) : LONGCARD;                   (* sum of Nat.digits b n *)
PROCEDURE DigLen (b, n: LONGCARD) : LONGCARD;                   (* length of Nat.digits b n *)
PROCEDURE DigRev (b, n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;   (* ofDigits b (digits b n).reverse *)
(* MathIR v4: ℤ subterms as checked LONGINT (same algorithms as lm2_nat.h);
   TRUE = an intermediate left [MIN(LONGINT), MAX(LONGINT)] *)
PROCEDURE NatAbs (a: LONGINT) : LONGCARD;
PROCEDURE ToNat (a: LONGINT) : LONGCARD;                        (* 0 for a < 0 *)
PROCEDURE ISign (a: LONGINT) : LONGINT;
PROCEDURE OfNat (x: LONGCARD; VAR r: LONGINT) : BOOLEAN;
PROCEDURE INeg (a: LONGINT; VAR r: LONGINT) : BOOLEAN;
PROCEDURE IAdd (a, b: LONGINT; VAR r: LONGINT) : BOOLEAN;
PROCEDURE ISub (a, b: LONGINT; VAR r: LONGINT) : BOOLEAN;
PROCEDURE IMul (a, b: LONGINT; VAR r: LONGINT) : BOOLEAN;
PROCEDURE IPow (a: LONGINT; e: LONGCARD; VAR r: LONGINT) : BOOLEAN;
(* MathIR v5 *)
PROCEDURE Xor (a, b: LONGCARD) : LONGCARD;                      (* bitwise exclusive or *)
END LM2Nat.
