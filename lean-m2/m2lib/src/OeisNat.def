DEFINITION MODULE OeisNat;
(* ℕ-valued sequence definitions from google-deepmind/formal-conjectures @ 84cf7f8,
   FormalConjectures/OEIS/<number>.lean, each transcribed from the file's `def a`.
   Every procedure computes `a n` exactly. It returns FALSE (r undefined) only when the
   exact value, or an intermediate value that the Lean definition forms, exceeds 2^64 - 1,
   or when n exceeds the bound stated next to the procedure. *)

TYPE
  Seq = PROCEDURE (LONGCARD, VAR LONGCARD) : BOOLEAN;

PROCEDURE A000002 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;   (* Kolakoski via wordPrefix; n <= 8000 *)
PROCEDURE A000041 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;   (* card (Nat.Partition n) *)
PROCEDURE A000224 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;   (* #{k^2 mod n : k < n}; n <= 2^20 *)
PROCEDURE A000945 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;   (* Euclid–Mullin *)
PROCEDURE A001146 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;   (* 2^(2^n) *)
PROCEDURE A001157 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;   (* σ_2 n *)
PROCEDURE A001818 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;   (* (∏_{k<n} (2k+1))^2 *)
PROCEDURE A002426 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;   (* central trinomial *)
PROCEDURE A002454 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;   (* 4^n n!^2 *)
PROCEDURE A003161 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;
PROCEDURE A005258 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;   (* Apéry *)
PROCEDURE A007013 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;   (* a(n+1) = 2^a(n) - 1 *)
PROCEDURE A017666 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;
PROCEDURE A022030 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;
PROCEDURE A038098 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;   (* #primesBelow (n^3); n^3 <= 2^20 *)
PROCEDURE A038107 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;   (* #primesBelow (n^2); n^2 <= 2^20 *)
PROCEDURE A048153 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;
PROCEDURE A051903 (n: LONGCARD; VAR r: LONGCARD) : BOOLEAN;   (* max exponent in factorisation *)
