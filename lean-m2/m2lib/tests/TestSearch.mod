MODULE TestSearch;
(* NatSearch: Nat.count / Nat.nth / Nat.find over the predicate catalogue, against brute-force
   Python definitions (tests/gen_search_tests.py). *)

IMPORT Check, NatSearch;

VAR
  r: LONGCARD; ok: BOOLEAN;

BEGIN
  Check.Nat("Count Prime < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Prime, 1000), 168);
  ok := NatSearch.Nth(NatSearch.Prime, 0, 1200, r);
  Check.Nat("Nth Prime", 0, ok, r, 2);
  ok := NatSearch.Nth(NatSearch.Prime, 1, 1200, r);
  Check.Nat("Nth Prime", 1, ok, r, 3);
  ok := NatSearch.Nth(NatSearch.Prime, 4, 1200, r);
  Check.Nat("Nth Prime", 4, ok, r, 11);
  ok := NatSearch.Nth(NatSearch.Prime, 196, 1200, r);
  Check.Fails("Nth Prime beyond limit", 196, ok);
  ok := NatSearch.GreatestBelow(NatSearch.Prime, 500, r);
  Check.Nat("GreatestBelow Prime 500", 500, ok, r, 499);
  Check.Nat("CountIcc Prime [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Prime, 100, 300), 37);
  ok := NatSearch.FindFrom(NatSearch.Prime, 777, 1200, r);
  Check.Nat("FindFrom Prime 777", 777, ok, r, 787);
  Check.Nat("Count Composite < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Composite, 1000), 830);
  ok := NatSearch.Nth(NatSearch.Composite, 0, 1200, r);
  Check.Nat("Nth Composite", 0, ok, r, 4);
  ok := NatSearch.Nth(NatSearch.Composite, 1, 1200, r);
  Check.Nat("Nth Composite", 1, ok, r, 6);
  ok := NatSearch.Nth(NatSearch.Composite, 4, 1200, r);
  Check.Nat("Nth Composite", 4, ok, r, 10);
  ok := NatSearch.Nth(NatSearch.Composite, 1003, 1200, r);
  Check.Fails("Nth Composite beyond limit", 1003, ok);
  ok := NatSearch.GreatestBelow(NatSearch.Composite, 500, r);
  Check.Nat("GreatestBelow Composite 500", 500, ok, r, 498);
  Check.Nat("CountIcc Composite [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Composite, 100, 300), 164);
  ok := NatSearch.FindFrom(NatSearch.Composite, 777, 1200, r);
  Check.Nat("FindFrom Composite 777", 777, ok, r, 777);
  Check.Nat("Count Squarefree < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Squarefree, 1000), 608);
  ok := NatSearch.Nth(NatSearch.Squarefree, 0, 1200, r);
  Check.Nat("Nth Squarefree", 0, ok, r, 1);
  ok := NatSearch.Nth(NatSearch.Squarefree, 1, 1200, r);
  Check.Nat("Nth Squarefree", 1, ok, r, 2);
  ok := NatSearch.Nth(NatSearch.Squarefree, 4, 1200, r);
  Check.Nat("Nth Squarefree", 4, ok, r, 6);
  ok := NatSearch.Nth(NatSearch.Squarefree, 730, 1200, r);
  Check.Fails("Nth Squarefree beyond limit", 730, ok);
  ok := NatSearch.GreatestBelow(NatSearch.Squarefree, 500, r);
  Check.Nat("GreatestBelow Squarefree 500", 500, ok, r, 499);
  Check.Nat("CountIcc Squarefree [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Squarefree, 100, 300), 122);
  ok := NatSearch.FindFrom(NatSearch.Squarefree, 777, 1200, r);
  Check.Nat("FindFrom Squarefree 777", 777, ok, r, 777);
  Check.Nat("Count Powerful < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Powerful, 1000), 54);
  ok := NatSearch.Nth(NatSearch.Powerful, 0, 1200, r);
  Check.Nat("Nth Powerful", 0, ok, r, 0);
  ok := NatSearch.Nth(NatSearch.Powerful, 1, 1200, r);
  Check.Nat("Nth Powerful", 1, ok, r, 1);
  ok := NatSearch.Nth(NatSearch.Powerful, 4, 1200, r);
  Check.Nat("Nth Powerful", 4, ok, r, 9);
  ok := NatSearch.Nth(NatSearch.Powerful, 60, 1200, r);
  Check.Fails("Nth Powerful beyond limit", 60, ok);
  ok := NatSearch.GreatestBelow(NatSearch.Powerful, 500, r);
  Check.Nat("GreatestBelow Powerful 500", 500, ok, r, 484);
  Check.Nat("CountIcc Powerful [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Powerful, 100, 300), 15);
  ok := NatSearch.FindFrom(NatSearch.Powerful, 777, 1200, r);
  Check.Nat("FindFrom Powerful 777", 777, ok, r, 784);
  Check.Nat("Count Square < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Square, 1000), 32);
  ok := NatSearch.Nth(NatSearch.Square, 0, 1200, r);
  Check.Nat("Nth Square", 0, ok, r, 0);
  ok := NatSearch.Nth(NatSearch.Square, 1, 1200, r);
  Check.Nat("Nth Square", 1, ok, r, 1);
  ok := NatSearch.Nth(NatSearch.Square, 4, 1200, r);
  Check.Nat("Nth Square", 4, ok, r, 16);
  ok := NatSearch.Nth(NatSearch.Square, 35, 1200, r);
  Check.Fails("Nth Square beyond limit", 35, ok);
  ok := NatSearch.GreatestBelow(NatSearch.Square, 500, r);
  Check.Nat("GreatestBelow Square 500", 500, ok, r, 484);
  Check.Nat("CountIcc Square [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Square, 100, 300), 8);
  ok := NatSearch.FindFrom(NatSearch.Square, 777, 1200, r);
  Check.Nat("FindFrom Square 777", 777, ok, r, 784);
  Check.Nat("Count PrimePow < 1000", 1000, TRUE, NatSearch.Count(NatSearch.PrimePow, 1000), 193);
  ok := NatSearch.Nth(NatSearch.PrimePow, 0, 1200, r);
  Check.Nat("Nth PrimePow", 0, ok, r, 2);
  ok := NatSearch.Nth(NatSearch.PrimePow, 1, 1200, r);
  Check.Nat("Nth PrimePow", 1, ok, r, 3);
  ok := NatSearch.Nth(NatSearch.PrimePow, 4, 1200, r);
  Check.Nat("Nth PrimePow", 4, ok, r, 7);
  ok := NatSearch.Nth(NatSearch.PrimePow, 222, 1200, r);
  Check.Fails("Nth PrimePow beyond limit", 222, ok);
  ok := NatSearch.GreatestBelow(NatSearch.PrimePow, 500, r);
  Check.Nat("GreatestBelow PrimePow 500", 500, ok, r, 499);
  Check.Nat("CountIcc PrimePow [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.PrimePow, 100, 300), 44);
  ok := NatSearch.FindFrom(NatSearch.PrimePow, 777, 1200, r);
  Check.Nat("FindFrom PrimePow 777", 777, ok, r, 787);
  Check.Nat("Count Even < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Even, 1000), 500);
  ok := NatSearch.Nth(NatSearch.Even, 0, 1200, r);
  Check.Nat("Nth Even", 0, ok, r, 0);
  ok := NatSearch.Nth(NatSearch.Even, 1, 1200, r);
  Check.Nat("Nth Even", 1, ok, r, 2);
  ok := NatSearch.Nth(NatSearch.Even, 4, 1200, r);
  Check.Nat("Nth Even", 4, ok, r, 8);
  ok := NatSearch.Nth(NatSearch.Even, 601, 1200, r);
  Check.Fails("Nth Even beyond limit", 601, ok);
  ok := NatSearch.GreatestBelow(NatSearch.Even, 500, r);
  Check.Nat("GreatestBelow Even 500", 500, ok, r, 498);
  Check.Nat("CountIcc Even [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Even, 100, 300), 101);
  ok := NatSearch.FindFrom(NatSearch.Even, 777, 1200, r);
  Check.Nat("FindFrom Even 777", 777, ok, r, 778);
  Check.Nat("Count Odd < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Odd, 1000), 500);
  ok := NatSearch.Nth(NatSearch.Odd, 0, 1200, r);
  Check.Nat("Nth Odd", 0, ok, r, 1);
  ok := NatSearch.Nth(NatSearch.Odd, 1, 1200, r);
  Check.Nat("Nth Odd", 1, ok, r, 3);
  ok := NatSearch.Nth(NatSearch.Odd, 4, 1200, r);
  Check.Nat("Nth Odd", 4, ok, r, 9);
  ok := NatSearch.Nth(NatSearch.Odd, 600, 1200, r);
  Check.Fails("Nth Odd beyond limit", 600, ok);
  ok := NatSearch.GreatestBelow(NatSearch.Odd, 500, r);
  Check.Nat("GreatestBelow Odd 500", 500, ok, r, 499);
  Check.Nat("CountIcc Odd [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Odd, 100, 300), 100);
  ok := NatSearch.FindFrom(NatSearch.Odd, 777, 1200, r);
  Check.Nat("FindFrom Odd 777", 777, ok, r, 777);
  Check.Nat("Count Perfect < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Perfect, 1000), 3);
  ok := NatSearch.Nth(NatSearch.Perfect, 0, 1200, r);
  Check.Nat("Nth Perfect", 0, ok, r, 6);
  ok := NatSearch.Nth(NatSearch.Perfect, 1, 1200, r);
  Check.Nat("Nth Perfect", 1, ok, r, 28);
  ok := NatSearch.Nth(NatSearch.Perfect, 3, 1200, r);
  Check.Fails("Nth Perfect beyond limit", 3, ok);
  ok := NatSearch.GreatestBelow(NatSearch.Perfect, 500, r);
  Check.Nat("GreatestBelow Perfect 500", 500, ok, r, 496);
  Check.Nat("CountIcc Perfect [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Perfect, 100, 300), 0);
  ok := NatSearch.FindFrom(NatSearch.Perfect, 777, 1200, r);
  Check.Fails("FindFrom Perfect 777", 777, ok);
  Check.Nat("Count Abundant < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Abundant, 1000), 245);
  ok := NatSearch.Nth(NatSearch.Abundant, 0, 1200, r);
  Check.Nat("Nth Abundant", 0, ok, r, 12);
  ok := NatSearch.Nth(NatSearch.Abundant, 1, 1200, r);
  Check.Nat("Nth Abundant", 1, ok, r, 18);
  ok := NatSearch.Nth(NatSearch.Abundant, 4, 1200, r);
  Check.Nat("Nth Abundant", 4, ok, r, 30);
  ok := NatSearch.Nth(NatSearch.Abundant, 293, 1200, r);
  Check.Fails("Nth Abundant beyond limit", 293, ok);
  ok := NatSearch.GreatestBelow(NatSearch.Abundant, 500, r);
  Check.Nat("GreatestBelow Abundant 500", 500, ok, r, 498);
  Check.Nat("CountIcc Abundant [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Abundant, 100, 300), 48);
  ok := NatSearch.FindFrom(NatSearch.Abundant, 777, 1200, r);
  Check.Nat("FindFrom Abundant 777", 777, ok, r, 780);
  Check.Nat("Count Deficient < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Deficient, 1000), 751);
  ok := NatSearch.Nth(NatSearch.Deficient, 0, 1200, r);
  Check.Nat("Nth Deficient", 0, ok, r, 1);
  ok := NatSearch.Nth(NatSearch.Deficient, 1, 1200, r);
  Check.Nat("Nth Deficient", 1, ok, r, 2);
  ok := NatSearch.Nth(NatSearch.Deficient, 4, 1200, r);
  Check.Nat("Nth Deficient", 4, ok, r, 5);
  ok := NatSearch.Nth(NatSearch.Deficient, 904, 1200, r);
  Check.Fails("Nth Deficient beyond limit", 904, ok);
  ok := NatSearch.GreatestBelow(NatSearch.Deficient, 500, r);
  Check.Nat("GreatestBelow Deficient 500", 500, ok, r, 499);
  Check.Nat("CountIcc Deficient [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Deficient, 100, 300), 153);
  ok := NatSearch.FindFrom(NatSearch.Deficient, 777, 1200, r);
  Check.Nat("FindFrom Deficient 777", 777, ok, r, 777);
  Check.Nat("Count Pseudoperfect < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Pseudoperfect, 1000), 246);
  ok := NatSearch.Nth(NatSearch.Pseudoperfect, 0, 1200, r);
  Check.Nat("Nth Pseudoperfect", 0, ok, r, 6);
  ok := NatSearch.Nth(NatSearch.Pseudoperfect, 1, 1200, r);
  Check.Nat("Nth Pseudoperfect", 1, ok, r, 12);
  ok := NatSearch.Nth(NatSearch.Pseudoperfect, 4, 1200, r);
  Check.Nat("Nth Pseudoperfect", 4, ok, r, 24);
  ok := NatSearch.Nth(NatSearch.Pseudoperfect, 294, 1200, r);
  Check.Fails("Nth Pseudoperfect beyond limit", 294, ok);
  ok := NatSearch.GreatestBelow(NatSearch.Pseudoperfect, 500, r);
  Check.Nat("GreatestBelow Pseudoperfect 500", 500, ok, r, 498);
  Check.Nat("CountIcc Pseudoperfect [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Pseudoperfect, 100, 300), 48);
  ok := NatSearch.FindFrom(NatSearch.Pseudoperfect, 777, 1200, r);
  Check.Nat("FindFrom Pseudoperfect 777", 777, ok, r, 780);
  Check.Nat("Count Weird < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Weird, 1000), 2);
  ok := NatSearch.Nth(NatSearch.Weird, 0, 1200, r);
  Check.Nat("Nth Weird", 0, ok, r, 70);
  ok := NatSearch.Nth(NatSearch.Weird, 1, 1200, r);
  Check.Nat("Nth Weird", 1, ok, r, 836);
  ok := NatSearch.Nth(NatSearch.Weird, 2, 1200, r);
  Check.Fails("Nth Weird beyond limit", 2, ok);
  ok := NatSearch.GreatestBelow(NatSearch.Weird, 500, r);
  Check.Nat("GreatestBelow Weird 500", 500, ok, r, 70);
  Check.Nat("CountIcc Weird [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Weird, 100, 300), 0);
  ok := NatSearch.FindFrom(NatSearch.Weird, 777, 1200, r);
  Check.Nat("FindFrom Weird 777", 777, ok, r, 836);
  Check.Nat("Count Triangular < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Triangular, 1000), 45);
  ok := NatSearch.Nth(NatSearch.Triangular, 0, 1200, r);
  Check.Nat("Nth Triangular", 0, ok, r, 0);
  ok := NatSearch.Nth(NatSearch.Triangular, 1, 1200, r);
  Check.Nat("Nth Triangular", 1, ok, r, 1);
  ok := NatSearch.Nth(NatSearch.Triangular, 4, 1200, r);
  Check.Nat("Nth Triangular", 4, ok, r, 10);
  ok := NatSearch.Nth(NatSearch.Triangular, 49, 1200, r);
  Check.Fails("Nth Triangular beyond limit", 49, ok);
  ok := NatSearch.GreatestBelow(NatSearch.Triangular, 500, r);
  Check.Nat("GreatestBelow Triangular 500", 500, ok, r, 496);
  Check.Nat("CountIcc Triangular [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Triangular, 100, 300), 11);
  ok := NatSearch.FindFrom(NatSearch.Triangular, 777, 1200, r);
  Check.Nat("FindFrom Triangular 777", 777, ok, r, 780);
  Check.Nat("Count Palindrome10 < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Palindrome10, 1000), 109);
  ok := NatSearch.Nth(NatSearch.Palindrome10, 0, 1200, r);
  Check.Nat("Nth Palindrome10", 0, ok, r, 0);
  ok := NatSearch.Nth(NatSearch.Palindrome10, 1, 1200, r);
  Check.Nat("Nth Palindrome10", 1, ok, r, 1);
  ok := NatSearch.Nth(NatSearch.Palindrome10, 4, 1200, r);
  Check.Nat("Nth Palindrome10", 4, ok, r, 4);
  ok := NatSearch.Nth(NatSearch.Palindrome10, 111, 1200, r);
  Check.Fails("Nth Palindrome10 beyond limit", 111, ok);
  ok := NatSearch.GreatestBelow(NatSearch.Palindrome10, 500, r);
  Check.Nat("GreatestBelow Palindrome10 500", 500, ok, r, 494);
  Check.Nat("CountIcc Palindrome10 [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Palindrome10, 100, 300), 20);
  ok := NatSearch.FindFrom(NatSearch.Palindrome10, 777, 1200, r);
  Check.Nat("FindFrom Palindrome10 777", 777, ok, r, 777);
  Check.Nat("Count Refactorable < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Refactorable, 1000), 92);
  ok := NatSearch.Nth(NatSearch.Refactorable, 0, 1200, r);
  Check.Nat("Nth Refactorable", 0, ok, r, 1);
  ok := NatSearch.Nth(NatSearch.Refactorable, 1, 1200, r);
  Check.Nat("Nth Refactorable", 1, ok, r, 2);
  ok := NatSearch.Nth(NatSearch.Refactorable, 4, 1200, r);
  Check.Nat("Nth Refactorable", 4, ok, r, 12);
  ok := NatSearch.Nth(NatSearch.Refactorable, 107, 1200, r);
  Check.Fails("Nth Refactorable beyond limit", 107, ok);
  ok := NatSearch.GreatestBelow(NatSearch.Refactorable, 500, r);
  Check.Nat("GreatestBelow Refactorable 500", 500, ok, r, 492);
  Check.Nat("CountIcc Refactorable [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Refactorable, 100, 300), 19);
  ok := NatSearch.FindFrom(NatSearch.Refactorable, 777, 1200, r);
  Check.Nat("FindFrom Refactorable 777", 777, ok, r, 792);
  Check.Nat("Count TwinPrime < 1000", 1000, TRUE, NatSearch.Count(NatSearch.TwinPrime, 1000), 35);
  ok := NatSearch.Nth(NatSearch.TwinPrime, 0, 1200, r);
  Check.Nat("Nth TwinPrime", 0, ok, r, 3);
  ok := NatSearch.Nth(NatSearch.TwinPrime, 1, 1200, r);
  Check.Nat("Nth TwinPrime", 1, ok, r, 5);
  ok := NatSearch.Nth(NatSearch.TwinPrime, 4, 1200, r);
  Check.Nat("Nth TwinPrime", 4, ok, r, 29);
  ok := NatSearch.Nth(NatSearch.TwinPrime, 41, 1200, r);
  Check.Fails("Nth TwinPrime beyond limit", 41, ok);
  ok := NatSearch.GreatestBelow(NatSearch.TwinPrime, 500, r);
  Check.Nat("GreatestBelow TwinPrime 500", 500, ok, r, 461);
  Check.Nat("CountIcc TwinPrime [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.TwinPrime, 100, 300), 11);
  ok := NatSearch.FindFrom(NatSearch.TwinPrime, 777, 1200, r);
  Check.Nat("FindFrom TwinPrime 777", 777, ok, r, 809);
  Check.Nat("Count SophieGermain < 1000", 1000, TRUE, NatSearch.Count(NatSearch.SophieGermain, 1000), 37);
  ok := NatSearch.Nth(NatSearch.SophieGermain, 0, 1200, r);
  Check.Nat("Nth SophieGermain", 0, ok, r, 2);
  ok := NatSearch.Nth(NatSearch.SophieGermain, 1, 1200, r);
  Check.Nat("Nth SophieGermain", 1, ok, r, 3);
  ok := NatSearch.Nth(NatSearch.SophieGermain, 4, 1200, r);
  Check.Nat("Nth SophieGermain", 4, ok, r, 23);
  ok := NatSearch.Nth(NatSearch.SophieGermain, 42, 1200, r);
  Check.Fails("Nth SophieGermain beyond limit", 42, ok);
  ok := NatSearch.GreatestBelow(NatSearch.SophieGermain, 500, r);
  Check.Nat("GreatestBelow SophieGermain 500", 500, ok, r, 491);
  Check.Nat("CountIcc SophieGermain [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.SophieGermain, 100, 300), 10);
  ok := NatSearch.FindFrom(NatSearch.SophieGermain, 777, 1200, r);
  Check.Nat("FindFrom SophieGermain 777", 777, ok, r, 809);
  Check.Nat("Count Practical < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Practical, 1000), 197);
  ok := NatSearch.Nth(NatSearch.Practical, 0, 1200, r);
  Check.Nat("Nth Practical", 0, ok, r, 1);
  ok := NatSearch.Nth(NatSearch.Practical, 1, 1200, r);
  Check.Nat("Nth Practical", 1, ok, r, 2);
  ok := NatSearch.Nth(NatSearch.Practical, 4, 1200, r);
  Check.Nat("Nth Practical", 4, ok, r, 8);
  ok := NatSearch.Nth(NatSearch.Practical, 231, 1200, r);
  Check.Fails("Nth Practical beyond limit", 231, ok);
  ok := NatSearch.GreatestBelow(NatSearch.Practical, 500, r);
  Check.Nat("GreatestBelow Practical 500", 500, ok, r, 496);
  Check.Nat("CountIcc Practical [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Practical, 100, 300), 41);
  ok := NatSearch.FindFrom(NatSearch.Practical, 777, 1200, r);
  Check.Nat("FindFrom Practical 777", 777, ok, r, 780);
  Check.Nat("Count Carmichael < 1000", 1000, TRUE, NatSearch.Count(NatSearch.Carmichael, 1000), 1);
  ok := NatSearch.Nth(NatSearch.Carmichael, 0, 1200, r);
  Check.Nat("Nth Carmichael", 0, ok, r, 561);
  ok := NatSearch.Nth(NatSearch.Carmichael, 1, 1200, r);
  Check.Nat("Nth Carmichael", 1, ok, r, 1105);
  ok := NatSearch.Nth(NatSearch.Carmichael, 2, 1200, r);
  Check.Fails("Nth Carmichael beyond limit", 2, ok);
  Check.Nat("CountIcc Carmichael [100, 300]", 100, TRUE, NatSearch.CountIcc(NatSearch.Carmichael, 100, 300), 0);
  ok := NatSearch.FindFrom(NatSearch.Carmichael, 777, 1200, r);
  Check.Nat("FindFrom Carmichael 777", 777, ok, r, 1105);
  Check.True("Triangular 2^64-1 false", NOT NatSearch.Triangular(18446744073709551615));
  Check.True("Triangular large", NatSearch.Triangular(18000000003000000000) AND NOT NatSearch.Triangular(18000000003000000001));
  Check.True("Prime 2^64-59", NatSearch.Prime(18446744073709551557));
  Check.True("TwinPrime at the top is false", NOT NatSearch.TwinPrime(18446744073709551557));
  Check.True("Pseudoperfect beyond bound", NOT NatSearch.Pseudoperfect(2000000));
  ok := NatSearch.Find(NatSearch.Perfect, 10, r); Check.Nat("Find Perfect", 10, ok, r, 6);
  ok := NatSearch.Find(NatSearch.Perfect, 5, r); Check.Fails("Find Perfect <= 5", 5, ok);
  ok := NatSearch.Nth(NatSearch.Perfect, 3, 9000, r); Check.Nat("4th perfect", 3, ok, r, 8128);
  ok := NatSearch.Nth(NatSearch.Weird, 1, 1000, r); Check.Nat("2nd weird", 1, ok, r, 836);
  ok := NatSearch.Nth(NatSearch.Carmichael, 5, 7000, r); Check.Nat("6th Carmichael", 5, ok, r, 6601);
  Check.Nat("Count Prime < 10^5", 0, TRUE, NatSearch.Count(NatSearch.Prime, 100000), 9592);
  Check.Done("TestSearch")
END TestSearch.
