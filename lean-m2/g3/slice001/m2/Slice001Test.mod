MODULE Slice001Test;
(* LEAN-M2-CC-001 SLICE-001 differential test driver.
   For every Lean reference case (lm2_cases.c, generated by Spec.lean) it checks
     * the CompCert-compiled C implementation   (through the FOR "C" binding), and
     * the native Modula-2 implementation        (CunninghamChain)
   against Lean's expected status and value. On OVERFLOW the out-parameter must be untouched.
   Exit status 0 only if every check passes. *)

FROM SYSTEM IMPORT ADR, TSIZE;
FROM libc IMPORT printf, exit;
FROM lm2_cases IMPORT lm2_case_count, lm2_case_get;
FROM lm2_cunningham IMPORT lm2_cunningham_first_kind_term;
FROM CunninghamChain IMPORT FirstKindTerm, Ok;

CONST
  Sentinel = 0DEADBEEFCAFEF00DH;

VAR
  i, count, okCases, ovCases, failC, failM: CARDINAL;
  p, n, ev, cv, mv: LONGCARD;
  est, cst, mst: INTEGER;

BEGIN
  IF (TSIZE(LONGCARD) # 8) OR (TSIZE(CARDINAL) # 4) OR (TSIZE(INTEGER) # 4) THEN
    printf("FAIL type widths\n");
    exit(2)
  END;
  (* NULL out-pointer must be rejected by the C implementation *)
  IF lm2_cunningham_first_kind_term(1, 1, NIL) # -1 THEN
    printf("FAIL C null-out check\n");
    exit(2)
  END;

  count := lm2_case_count();
  okCases := 0; ovCases := 0; failC := 0; failM := 0;
  i := 0;
  WHILE i < count DO
    IF lm2_case_get(i, ADR(p), ADR(n), ADR(est), ADR(ev)) # 0 THEN
      printf("FAIL reading case %u\n", i);
      exit(2)
    END;
    cv := Sentinel; mv := Sentinel;
    cst := lm2_cunningham_first_kind_term(p, n, ADR(cv));
    mst := FirstKindTerm(p, n, mv);
    IF est = Ok THEN INC(okCases) ELSE INC(ovCases) END;

    IF (cst # est) OR ((est = Ok) AND (cv # ev)) OR ((est # Ok) AND (cv # Sentinel)) THEN
      INC(failC);
      IF failC <= 20 THEN printf("FAIL C  case %u: status %d expected %d\n", i, cst, est) END
    END;
    IF (mst # est) OR ((est = Ok) AND (mv # ev)) OR ((est # Ok) AND (mv # Sentinel)) THEN
      INC(failM);
      IF failM <= 20 THEN printf("FAIL M2 case %u: status %d expected %d\n", i, mst, est) END
    END;
    INC(i)
  END;

  printf("SLICE001 cases=%u ok=%u overflow=%u fail_c=%u fail_m2=%u\n",
         count, okCases, ovCases, failC, failM);
  IF (count > 0) AND (failC = 0) AND (failM = 0) THEN
    printf("SLICE001 DIFFERENTIAL: PASS\n");
    exit(0)
  ELSE
    printf("SLICE001 DIFFERENTIAL: FAIL\n");
    exit(1)
  END
END Slice001Test.
