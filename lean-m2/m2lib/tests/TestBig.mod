MODULE TestBig;
(* Checks BigNat, BigInt, Rat, the BigNat/Rat procedures of Combinatorics, and Matrix against
   Python's exact integer and Fraction arithmetic (tests/gen_big_tests.py). Values at or above
   BigNat's capacity (2^8192) must make the procedure return FALSE. *)

IMPORT Check, BigNat, BigInt, Rat, Combinatorics, Matrix, Poly;

VAR
  a1, a2, a3, a4: BigNat.T; b1, b2, b3, b4: BigInt.T; r1, r2, r3: Rat.T;
  q1n, q2n: BigInt.T; q1d, q2d: BigNat.T;
  im, im2: Matrix.IntMat; rm, rm2, rm3: Matrix.RatMat;
  n: LONGCARD; x: LONGINT; c: CARDINAL; ci: INTEGER; ci2: CARDINAL; ok: BOOLEAN;
  buf: ARRAY [0..5200] OF CHAR;
  p1, p2, p3, p4: Poly.T;

PROCEDURE NatIs (name: ARRAY OF CHAR; VAR v: BigNat.T; ok: BOOLEAN; want: ARRAY OF CHAR);
BEGIN
  IF ok THEN ok := BigNat.ToDecimal(v, buf) END;
  Check.Text(name, ok, buf, want)
END NatIs;

PROCEDURE IntIs (name: ARRAY OF CHAR; VAR v: BigInt.T; ok: BOOLEAN; want: ARRAY OF CHAR);
BEGIN
  IF ok THEN ok := BigInt.ToDecimal(v, buf) END;
  Check.Text(name, ok, buf, want)
END IntIs;

PROCEDURE PolyIs (name: ARRAY OF CHAR; VAR v: Poly.T; ok: BOOLEAN; want: ARRAY OF CHAR);
BEGIN
  IF ok THEN ok := Poly.ToText(v, buf) END;
  Check.Text(name, ok, buf, want)
END PolyIs;

PROCEDURE RatIs (name: ARRAY OF CHAR; VAR v: Rat.T; ok: BOOLEAN; want: ARRAY OF CHAR);
BEGIN
  IF ok THEN ok := Rat.ToText(v, buf) END;
  Check.Text(name, ok, buf, want)
END RatIs;

BEGIN
  ok := BigNat.FromDecimal("0", a1); Check.True("load", ok);
  ok := BigNat.FromDecimal("0", a2); Check.True("load", ok);
  ok := BigNat.Add(a1, a2, a3);
  NatIs("BigNat.Add", a3, ok, "0");
  BigNat.Sub(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Sub", a3, ok, "0");
  ok := BigNat.Mul(a1, a2, a3);
  NatIs("BigNat.Mul", a3, ok, "0");
  BigNat.DivMod(a1, a2, a3, a4); ok := TRUE;
  NatIs("BigNat.DivMod.q", a3, ok, "0");
  NatIs("BigNat.DivMod.m", a4, ok, "0");
  BigNat.Gcd(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Gcd", a3, ok, "0");
  ok := BigNat.Lcm(a1, a2, a3);
  NatIs("BigNat.Lcm", a3, ok, "0");
  BigNat.Sqrt(a1, a3); ok := TRUE;
  NatIs("BigNat.Sqrt", a3, ok, "0");
  Check.Int("BigNat.Cmp", 0, TRUE, VAL(LONGINT, BigNat.Cmp(a1, a2)), 0);
  Check.Nat("BigNat.BitLength", 0, TRUE, VAL(LONGCARD, BigNat.BitLength(a1)), 0);
  ok := BigNat.ToNat(a1, n);
  Check.Nat("BigNat.ToNat", 0, ok, n, 0);
  BigNat.DivModSmall(a1, 1000000007, a3, c); ok := TRUE;
  NatIs("BigNat.DivModSmall.q", a3, ok, "0");
  Check.Nat("BigNat.DivModSmall.r", 0, TRUE, VAL(LONGCARD, c), 0);
  ok := BigNat.FromDecimal("1", a1); Check.True("load", ok);
  ok := BigNat.FromDecimal("4294967295", a2); Check.True("load", ok);
  ok := BigNat.Add(a1, a2, a3);
  NatIs("BigNat.Add", a3, ok, "4294967296");
  BigNat.Sub(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Sub", a3, ok, "0");
  ok := BigNat.Mul(a1, a2, a3);
  NatIs("BigNat.Mul", a3, ok, "4294967295");
  BigNat.DivMod(a1, a2, a3, a4); ok := TRUE;
  NatIs("BigNat.DivMod.q", a3, ok, "0");
  NatIs("BigNat.DivMod.m", a4, ok, "1");
  BigNat.Gcd(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Gcd", a3, ok, "1");
  ok := BigNat.Lcm(a1, a2, a3);
  NatIs("BigNat.Lcm", a3, ok, "4294967295");
  BigNat.Sqrt(a1, a3); ok := TRUE;
  NatIs("BigNat.Sqrt", a3, ok, "1");
  Check.Int("BigNat.Cmp", 1, TRUE, VAL(LONGINT, BigNat.Cmp(a1, a2)), -1);
  Check.Nat("BigNat.BitLength", 1, TRUE, VAL(LONGCARD, BigNat.BitLength(a1)), 1);
  ok := BigNat.ToNat(a1, n);
  Check.Nat("BigNat.ToNat", 1, ok, n, 1);
  BigNat.DivModSmall(a1, 1000000007, a3, c); ok := TRUE;
  NatIs("BigNat.DivModSmall.q", a3, ok, "0");
  Check.Nat("BigNat.DivModSmall.r", 1, TRUE, VAL(LONGCARD, c), 1);
  ok := BigNat.FromDecimal("4294967295", a1); Check.True("load", ok);
  ok := BigNat.FromDecimal("4294967296", a2); Check.True("load", ok);
  ok := BigNat.Add(a1, a2, a3);
  NatIs("BigNat.Add", a3, ok, "8589934591");
  BigNat.Sub(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Sub", a3, ok, "0");
  ok := BigNat.Mul(a1, a2, a3);
  NatIs("BigNat.Mul", a3, ok, "18446744069414584320");
  BigNat.DivMod(a1, a2, a3, a4); ok := TRUE;
  NatIs("BigNat.DivMod.q", a3, ok, "0");
  NatIs("BigNat.DivMod.m", a4, ok, "4294967295");
  BigNat.Gcd(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Gcd", a3, ok, "1");
  ok := BigNat.Lcm(a1, a2, a3);
  NatIs("BigNat.Lcm", a3, ok, "18446744069414584320");
  BigNat.Sqrt(a1, a3); ok := TRUE;
  NatIs("BigNat.Sqrt", a3, ok, "65535");
  Check.Int("BigNat.Cmp", 2, TRUE, VAL(LONGINT, BigNat.Cmp(a1, a2)), -1);
  Check.Nat("BigNat.BitLength", 2, TRUE, VAL(LONGCARD, BigNat.BitLength(a1)), 32);
  ok := BigNat.ToNat(a1, n);
  Check.Nat("BigNat.ToNat", 2, ok, n, 4294967295);
  BigNat.DivModSmall(a1, 1000000007, a3, c); ok := TRUE;
  NatIs("BigNat.DivModSmall.q", a3, ok, "4");
  Check.Nat("BigNat.DivModSmall.r", 2, TRUE, VAL(LONGCARD, c), 294967267);
  ok := BigNat.FromDecimal("4294967296", a1); Check.True("load", ok);
  ok := BigNat.FromDecimal("", a2); Check.True("load", ok);
  ok := BigNat.Add(a1, a2, a3);
  NatIs("BigNat.Add", a3, ok, "");
  BigNat.Sub(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Sub", a3, ok, "0");
  ok := BigNat.Mul(a1, a2, a3);
  NatIs("BigNat.Mul", a3, ok, "");
  BigNat.DivMod(a1, a2, a3, a4); ok := TRUE;
  NatIs("BigNat.DivMod.q", a3, ok, "0");
  NatIs("BigNat.DivMod.m", a4, ok, "4294967296");
  BigNat.Gcd(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Gcd", a3, ok, "4");
  ok := BigNat.Lcm(a1, a2, a3);
  NatIs("BigNat.Lcm", a3, ok, "");
  BigNat.Sqrt(a1, a3); ok := TRUE;
  NatIs("BigNat.Sqrt", a3, ok, "65536");
  Check.Int("BigNat.Cmp", 3, TRUE, VAL(LONGINT, BigNat.Cmp(a1, a2)), -1);
  Check.Nat("BigNat.BitLength", 3, TRUE, VAL(LONGCARD, BigNat.BitLength(a1)), 33);
  ok := BigNat.ToNat(a1, n);
  Check.Nat("BigNat.ToNat", 3, ok, n, 4294967296);
  BigNat.DivModSmall(a1, 1000000007, a3, c); ok := TRUE;
  NatIs("BigNat.DivModSmall.q", a3, ok, "4");
  Check.Nat("BigNat.DivModSmall.r", 3, TRUE, VAL(LONGCARD, c), 294967268);
  ok := BigNat.FromDecimal("18446744073709551615", a1); Check.True("load", ok);
  ok := BigNat.FromDecimal("18446744073709551616", a2); Check.True("load", ok);
  ok := BigNat.Add(a1, a2, a3);
  NatIs("BigNat.Add", a3, ok, "36893488147419103231");
  BigNat.Sub(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Sub", a3, ok, "0");
  ok := BigNat.Mul(a1, a2, a3);
  NatIs("BigNat.Mul", a3, ok, "340282366920938463444927863358058659840");
  BigNat.DivMod(a1, a2, a3, a4); ok := TRUE;
  NatIs("BigNat.DivMod.q", a3, ok, "0");
  NatIs("BigNat.DivMod.m", a4, ok, "18446744073709551615");
  BigNat.Gcd(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Gcd", a3, ok, "1");
  ok := BigNat.Lcm(a1, a2, a3);
  NatIs("BigNat.Lcm", a3, ok, "340282366920938463444927863358058659840");
  BigNat.Sqrt(a1, a3); ok := TRUE;
  NatIs("BigNat.Sqrt", a3, ok, "4294967295");
  Check.Int("BigNat.Cmp", 4, TRUE, VAL(LONGINT, BigNat.Cmp(a1, a2)), -1);
  Check.Nat("BigNat.BitLength", 4, TRUE, VAL(LONGCARD, BigNat.BitLength(a1)), 64);
  ok := BigNat.ToNat(a1, n);
  Check.Nat("BigNat.ToNat", 4, ok, n, 18446744073709551615);
  BigNat.DivModSmall(a1, 1000000007, a3, c); ok := TRUE;
  NatIs("BigNat.DivModSmall.q", a3, ok, "18446743944");
  Check.Nat("BigNat.DivModSmall.r", 4, TRUE, VAL(LONGCARD, c), 582344007);
  ok := BigNat.FromDecimal("18446744073709551616", a1); Check.True("load", ok);
  ok := BigNat.FromDecimal("10000000000000000000000000000000000000007", a2); Check.True("load", ok);
  ok := BigNat.Add(a1, a2, a3);
  NatIs("BigNat.Add", a3, ok, "10000000000000000000018446744073709551623");
  BigNat.Sub(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Sub", a3, ok, "0");
  ok := BigNat.Mul(a1, a2, a3);
  NatIs("BigNat.Mul", a3, ok, "184467440737095516160000000000000000000129127208515966861312");
  BigNat.DivMod(a1, a2, a3, a4); ok := TRUE;
  NatIs("BigNat.DivMod.q", a3, ok, "0");
  NatIs("BigNat.DivMod.m", a4, ok, "18446744073709551616");
  BigNat.Gcd(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Gcd", a3, ok, "1");
  ok := BigNat.Lcm(a1, a2, a3);
  NatIs("BigNat.Lcm", a3, ok, "184467440737095516160000000000000000000129127208515966861312");
  BigNat.Sqrt(a1, a3); ok := TRUE;
  NatIs("BigNat.Sqrt", a3, ok, "4294967296");
  Check.Int("BigNat.Cmp", 5, TRUE, VAL(LONGINT, BigNat.Cmp(a1, a2)), -1);
  Check.Nat("BigNat.BitLength", 5, TRUE, VAL(LONGCARD, BigNat.BitLength(a1)), 65);
  ok := BigNat.ToNat(a1, n);
  Check.Fails("BigNat.ToNat", 5, ok);
  BigNat.DivModSmall(a1, 1000000007, a3, c); ok := TRUE;
  NatIs("BigNat.DivModSmall.q", a3, ok, "18446743944");
  Check.Nat("BigNat.DivModSmall.r", 5, TRUE, VAL(LONGCARD, c), 582344008);
  ok := BigNat.FromDecimal("10000000000000000000000000000000000000007", a1); Check.True("load", ok);
  ok := BigNat.FromDecimal("4318558741936306192", a2); Check.True("load", ok);
  ok := BigNat.Add(a1, a2, a3);
  NatIs("BigNat.Add", a3, ok, "10000000000000000000004318558741936306199");
  BigNat.Sub(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Sub", a3, ok, "9999999999999999999995681441258063693815");
  ok := BigNat.Mul(a1, a2, a3);
  NatIs("BigNat.Mul", a3, ok, "43185587419363061920000000000000000000030229911193554143344");
  BigNat.DivMod(a1, a2, a3, a4); ok := TRUE;
  NatIs("BigNat.DivMod.q", a3, ok, "2315587351607104427845");
  NatIs("BigNat.DivMod.m", a4, ok, "3558429873109283767");
  BigNat.Gcd(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Gcd", a3, ok, "1");
  ok := BigNat.Lcm(a1, a2, a3);
  NatIs("BigNat.Lcm", a3, ok, "43185587419363061920000000000000000000030229911193554143344");
  BigNat.Sqrt(a1, a3); ok := TRUE;
  NatIs("BigNat.Sqrt", a3, ok, "100000000000000000000");
  Check.Int("BigNat.Cmp", 6, TRUE, VAL(LONGINT, BigNat.Cmp(a1, a2)), 1);
  Check.Nat("BigNat.BitLength", 6, TRUE, VAL(LONGCARD, BigNat.BitLength(a1)), 133);
  ok := BigNat.ToNat(a1, n);
  Check.Fails("BigNat.ToNat", 6, ok);
  BigNat.DivModSmall(a1, 1000000007, a3, c); ok := TRUE;
  NatIs("BigNat.DivModSmall.q", a3, ok, "9999999930000000489999996570000");
  Check.Nat("BigNat.DivModSmall.r", 6, TRUE, VAL(LONGCARD, c), 24010007);
  ok := BigNat.FromDecimal("36360291795869936842385267079543319118023385026001623040346035832580600191583895484198508262979388783308179702534403855752855931517013066142992430916562025780021771247847643450125342836565813209972590371590152578728008385990139795377610001", a1); Check.True("load", ok);
  ok := BigNat.FromDecimal("", a2); Check.True("load", ok);
  ok := BigNat.Add(a1, a2, a3);
  NatIs("BigNat.Add", a3, ok, "");
  BigNat.Sub(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Sub", a3, ok, "0");
  ok := BigNat.Mul(a1, a2, a3);
  NatIs("BigNat.Mul", a3, ok, "");
  BigNat.DivMod(a1, a2, a3, a4); ok := TRUE;
  NatIs("BigNat.DivMod.q", a3, ok, "0");
  NatIs("BigNat.DivMod.m", a4, ok, "36360291795869936842385267079543319118023385026001623040346035832580600191583895484198508262979388783308179702534403855752855931517013066142992430916562025780021771247847643450125342836565813209972590371590152578728008385990139795377610001");
  BigNat.Gcd(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Gcd", a3, ok, "1");
  ok := BigNat.Lcm(a1, a2, a3);
  NatIs("BigNat.Lcm", a3, ok, "");
  BigNat.Sqrt(a1, a3); ok := TRUE;
  NatIs("BigNat.Sqrt", a3, ok, "190683748116796615589766511371277507701260426349148337437043654910886245033973163156381027646240890976422037778530726249");
  Check.Int("BigNat.Cmp", 7, TRUE, VAL(LONGINT, BigNat.Cmp(a1, a2)), -1);
  Check.Nat("BigNat.BitLength", 7, TRUE, VAL(LONGCARD, BigNat.BitLength(a1)), 793);
  ok := BigNat.ToNat(a1, n);
  Check.Fails("BigNat.ToNat", 7, ok);
  BigNat.DivModSmall(a1, 1000000007, a3, c); ok := TRUE;
  NatIs("BigNat.DivModSmall.q", a3, ok, "36360291541347896052949994708893356155769891935612379491059379395164944425429284506193516719624771745934777480990961488816125509804134497514050948318205387552584058379759234791810699293890918152736163302437009461668942154307544715");
  Check.Nat("BigNat.DivModSmall.r", 7, TRUE, VAL(LONGCARD, c), 224796996);
  ok := BigNat.FromDecimal("", a1); Check.True("load", ok);
  ok := BigNat.FromDecimal("14367438163497952869", a2); Check.True("load", ok);
  ok := BigNat.Add(a1, a2, a3);
  NatIs("BigNat.Add", a3, ok, "");
  BigNat.Sub(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Sub", a3, ok, "");
  ok := BigNat.Mul(a1, a2, a3);
  NatIs("BigNat.Mul", a3, ok, "");
  BigNat.DivMod(a1, a2, a3, a4); ok := TRUE;
  NatIs("BigNat.DivMod.q", a3, ok, "");
  NatIs("BigNat.DivMod.m", a4, ok, "11998887417471261397");
  BigNat.Gcd(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Gcd", a3, ok, "1");
  ok := BigNat.Lcm(a1, a2, a3);
  NatIs("BigNat.Lcm", a3, ok, "");
  BigNat.Sqrt(a1, a3); ok := TRUE;
  NatIs("BigNat.Sqrt", a3, ok, "");
  Check.Int("BigNat.Cmp", 8, TRUE, VAL(LONGINT, BigNat.Cmp(a1, a2)), 1);
  Check.Nat("BigNat.BitLength", 8, TRUE, VAL(LONGCARD, BigNat.BitLength(a1)), 4001);
  ok := BigNat.ToNat(a1, n);
  Check.Fails("BigNat.ToNat", 8, ok);
  BigNat.DivModSmall(a1, 1000000007, a3, c); ok := TRUE;
  NatIs("BigNat.DivModSmall.q", a3, ok, "");
  Check.Nat("BigNat.DivModSmall.r", 8, TRUE, VAL(LONGCARD, c), 787955941);
  ok := BigNat.FromDecimal("14367438163497952869", a1); Check.True("load", ok);
  ok := BigNat.FromDecimal("27983285662825918978", a2); Check.True("load", ok);
  ok := BigNat.Add(a1, a2, a3);
  NatIs("BigNat.Add", a3, ok, "42350723826323871847");
  BigNat.Sub(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Sub", a3, ok, "0");
  ok := BigNat.Mul(a1, a2, a3);
  NatIs("BigNat.Mul", a3, ok, "402048126372150216129913890416656647882");
  BigNat.DivMod(a1, a2, a3, a4); ok := TRUE;
  NatIs("BigNat.DivMod.q", a3, ok, "0");
  NatIs("BigNat.DivMod.m", a4, ok, "14367438163497952869");
  BigNat.Gcd(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Gcd", a3, ok, "7");
  ok := BigNat.Lcm(a1, a2, a3);
  NatIs("BigNat.Lcm", a3, ok, "57435446624592888018559127202379521126");
  BigNat.Sqrt(a1, a3); ok := TRUE;
  NatIs("BigNat.Sqrt", a3, ok, "3790440365");
  Check.Int("BigNat.Cmp", 9, TRUE, VAL(LONGINT, BigNat.Cmp(a1, a2)), -1);
  Check.Nat("BigNat.BitLength", 9, TRUE, VAL(LONGCARD, BigNat.BitLength(a1)), 64);
  ok := BigNat.ToNat(a1, n);
  Check.Nat("BigNat.ToNat", 9, ok, n, 14367438163497952869);
  BigNat.DivModSmall(a1, 1000000007, a3, c); ok := TRUE;
  NatIs("BigNat.DivModSmall.q", a3, ok, "14367438062");
  Check.Nat("BigNat.DivModSmall.r", 9, TRUE, VAL(LONGCARD, c), 925886435);
  ok := BigNat.FromDecimal("", a1); Check.True("load", ok);
  ok := BigNat.FromDecimal("6803717635409615298", a2); Check.True("load", ok);
  ok := BigNat.Add(a1, a2, a3);
  NatIs("BigNat.Add", a3, ok, "");
  BigNat.Sub(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Sub", a3, ok, "");
  ok := BigNat.Mul(a1, a2, a3);
  NatIs("BigNat.Mul", a3, ok, "");
  BigNat.DivMod(a1, a2, a3, a4); ok := TRUE;
  NatIs("BigNat.DivMod.q", a3, ok, "595583957245546456027084986387272030766837316182045007090608794988101397966746426829002957458925687168398268301104574776061564280900867808781227283223861616538268627596947160730005396695747796772114239237015930397669271834094148710788027860094786126996392483836910768123552792981010");
  NatIs("BigNat.DivMod.m", a4, ok, "6057626128256611072");
  BigNat.Gcd(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Gcd", a3, ok, "2");
  ok := BigNat.Lcm(a1, a2, a3);
  NatIs("BigNat.Lcm", a3, ok, "");
  BigNat.Sqrt(a1, a3); ok := TRUE;
  NatIs("BigNat.Sqrt", a3, ok, "2013003992365283598523770792138280221753142933908265279021028632258210770809643894363501971956877214156758706567351274621521726097676930946518878697032");
  Check.Int("BigNat.Cmp", 10, TRUE, VAL(LONGINT, BigNat.Cmp(a1, a2)), 1);
  Check.Nat("BigNat.BitLength", 10, TRUE, VAL(LONGCARD, BigNat.BitLength(a1)), 999);
  ok := BigNat.ToNat(a1, n);
  Check.Fails("BigNat.ToNat", 10, ok);
  BigNat.DivModSmall(a1, 1000000007, a3, c); ok := TRUE;
  NatIs("BigNat.DivModSmall.q", a3, ok, "4052185044913275433821455893535004713295909004502110689376728863538374886306353664227614333253144394632532918425294489258845720057791028512138809014794193260105145569981662712047452741944535878908215522481638585246198463912434463734625255040447177707413489299424110313226656191556152651960058");
  Check.Nat("BigNat.DivModSmall.r", 10, TRUE, VAL(LONGCARD, c), 412381646);
  ok := BigNat.FromDecimal("6803717635409615298", a1); Check.True("load", ok);
  ok := BigNat.FromDecimal("611685380", a2); Check.True("load", ok);
  ok := BigNat.Add(a1, a2, a3);
  NatIs("BigNat.Add", a3, ok, "6803717636021300678");
  BigNat.Sub(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Sub", a3, ok, "6803717634797929918");
  ok := BigNat.Mul(a1, a2, a3);
  NatIs("BigNat.Mul", a3, ok, "4161734607228231989210943240");
  BigNat.DivMod(a1, a2, a3, a4); ok := TRUE;
  NatIs("BigNat.DivMod.q", a3, ok, "11122903796");
  NatIs("BigNat.DivMod.m", a4, ok, "249912818");
  BigNat.Gcd(a1, a2, a3); ok := TRUE;
  NatIs("BigNat.Gcd", a3, ok, "2");
  ok := BigNat.Lcm(a1, a2, a3);
  NatIs("BigNat.Lcm", a3, ok, "2080867303614115994605471620");
  BigNat.Sqrt(a1, a3); ok := TRUE;
  NatIs("BigNat.Sqrt", a3, ok, "2608393688");
  Check.Int("BigNat.Cmp", 11, TRUE, VAL(LONGINT, BigNat.Cmp(a1, a2)), 1);
