MODULE TestCore;
(* Checks NatArith, NumberTheory, ModArith, Digits and the 64-bit Combinatorics procedures
   against naive reference definitions (tests/gen_core_tests.py). A value of 2^64 or more
   must make the procedure return FALSE. *)

IMPORT Check, NatArith, NumberTheory, ModArith, Digits, Combinatorics;

VAR
  n, k: LONGCARD; x, s, t: LONGINT; ok: BOOLEAN; dl: Digits.List;

BEGIN
  ok := NatArith.Add(0, 0, n);
  Check.Nat("NatArith.Add", 0, ok, n, 0);
  ok := NatArith.Mul(0, 0, n);
  Check.Nat("NatArith.Mul", 0, ok, n, 0);
  Check.Nat("NatArith.Sub", 0, TRUE, NatArith.Sub(0, 0), 0);
  Check.Nat("NatArith.Div", 0, TRUE, NatArith.Div(0, 0), 0);
  Check.Nat("NatArith.Mod", 0, TRUE, NatArith.Mod(0, 0), 0);
  Check.Nat("NatArith.Dist", 0, TRUE, NatArith.Dist(0, 0), 0);
  Check.Nat("NatArith.Xor", 0, TRUE, NatArith.Xor(0, 0), 0);
  Check.Nat("NatArith.LAnd", 0, TRUE, NatArith.LAnd(0, 0), 0);
  Check.Nat("NatArith.LOr", 0, TRUE, NatArith.LOr(0, 0), 0);
  Check.True("NatArith.Dvd(0,0)", (NatArith.Dvd(0, 0)) = TRUE);
  ok := NatArith.Add(0, 5, n);
  Check.Nat("NatArith.Add", 0, ok, n, 5);
  ok := NatArith.Mul(0, 5, n);
  Check.Nat("NatArith.Mul", 0, ok, n, 0);
  Check.Nat("NatArith.Sub", 0, TRUE, NatArith.Sub(0, 5), 0);
  Check.Nat("NatArith.Div", 0, TRUE, NatArith.Div(0, 5), 0);
  Check.Nat("NatArith.Mod", 0, TRUE, NatArith.Mod(0, 5), 0);
  Check.Nat("NatArith.Dist", 0, TRUE, NatArith.Dist(0, 5), 5);
  Check.Nat("NatArith.Xor", 0, TRUE, NatArith.Xor(0, 5), 5);
  Check.Nat("NatArith.LAnd", 0, TRUE, NatArith.LAnd(0, 5), 0);
  Check.Nat("NatArith.LOr", 0, TRUE, NatArith.LOr(0, 5), 5);
  Check.True("NatArith.Dvd(0,5)", (NatArith.Dvd(0, 5)) = FALSE);
  ok := NatArith.Add(5, 0, n);
  Check.Nat("NatArith.Add", 5, ok, n, 5);
  ok := NatArith.Mul(5, 0, n);
  Check.Nat("NatArith.Mul", 5, ok, n, 0);
  Check.Nat("NatArith.Sub", 5, TRUE, NatArith.Sub(5, 0), 5);
  Check.Nat("NatArith.Div", 5, TRUE, NatArith.Div(5, 0), 0);
  Check.Nat("NatArith.Mod", 5, TRUE, NatArith.Mod(5, 0), 5);
  Check.Nat("NatArith.Dist", 5, TRUE, NatArith.Dist(5, 0), 5);
  Check.Nat("NatArith.Xor", 5, TRUE, NatArith.Xor(5, 0), 5);
  Check.Nat("NatArith.LAnd", 5, TRUE, NatArith.LAnd(5, 0), 0);
  Check.Nat("NatArith.LOr", 5, TRUE, NatArith.LOr(5, 0), 5);
  Check.True("NatArith.Dvd(5,0)", (NatArith.Dvd(5, 0)) = TRUE);
  ok := NatArith.Add(7, 3, n);
  Check.Nat("NatArith.Add", 7, ok, n, 10);
  ok := NatArith.Mul(7, 3, n);
  Check.Nat("NatArith.Mul", 7, ok, n, 21);
  Check.Nat("NatArith.Sub", 7, TRUE, NatArith.Sub(7, 3), 4);
  Check.Nat("NatArith.Div", 7, TRUE, NatArith.Div(7, 3), 2);
  Check.Nat("NatArith.Mod", 7, TRUE, NatArith.Mod(7, 3), 1);
  Check.Nat("NatArith.Dist", 7, TRUE, NatArith.Dist(7, 3), 4);
  Check.Nat("NatArith.Xor", 7, TRUE, NatArith.Xor(7, 3), 4);
  Check.Nat("NatArith.LAnd", 7, TRUE, NatArith.LAnd(7, 3), 3);
  Check.Nat("NatArith.LOr", 7, TRUE, NatArith.LOr(7, 3), 7);
  Check.True("NatArith.Dvd(7,3)", (NatArith.Dvd(7, 3)) = FALSE);
  ok := NatArith.Add(3, 7, n);
  Check.Nat("NatArith.Add", 3, ok, n, 10);
  ok := NatArith.Mul(3, 7, n);
  Check.Nat("NatArith.Mul", 3, ok, n, 21);
  Check.Nat("NatArith.Sub", 3, TRUE, NatArith.Sub(3, 7), 0);
  Check.Nat("NatArith.Div", 3, TRUE, NatArith.Div(3, 7), 0);
  Check.Nat("NatArith.Mod", 3, TRUE, NatArith.Mod(3, 7), 3);
  Check.Nat("NatArith.Dist", 3, TRUE, NatArith.Dist(3, 7), 4);
  Check.Nat("NatArith.Xor", 3, TRUE, NatArith.Xor(3, 7), 4);
  Check.Nat("NatArith.LAnd", 3, TRUE, NatArith.LAnd(3, 7), 3);
  Check.Nat("NatArith.LOr", 3, TRUE, NatArith.LOr(3, 7), 7);
  Check.True("NatArith.Dvd(3,7)", (NatArith.Dvd(3, 7)) = FALSE);
  ok := NatArith.Add(18446744073709551615, 1, n);
  Check.Fails("NatArith.Add", 18446744073709551615, ok);
  ok := NatArith.Mul(18446744073709551615, 1, n);
  Check.Nat("NatArith.Mul", 18446744073709551615, ok, n, 18446744073709551615);
  Check.Nat("NatArith.Sub", 18446744073709551615, TRUE, NatArith.Sub(18446744073709551615, 1), 18446744073709551614);
  Check.Nat("NatArith.Div", 18446744073709551615, TRUE, NatArith.Div(18446744073709551615, 1), 18446744073709551615);
  Check.Nat("NatArith.Mod", 18446744073709551615, TRUE, NatArith.Mod(18446744073709551615, 1), 0);
  Check.Nat("NatArith.Dist", 18446744073709551615, TRUE, NatArith.Dist(18446744073709551615, 1), 18446744073709551614);
  Check.Nat("NatArith.Xor", 18446744073709551615, TRUE, NatArith.Xor(18446744073709551615, 1), 18446744073709551614);
  Check.Nat("NatArith.LAnd", 18446744073709551615, TRUE, NatArith.LAnd(18446744073709551615, 1), 1);
  Check.Nat("NatArith.LOr", 18446744073709551615, TRUE, NatArith.LOr(18446744073709551615, 1), 18446744073709551615);
  Check.True("NatArith.Dvd(18446744073709551615,1)", (NatArith.Dvd(18446744073709551615, 1)) = FALSE);
  ok := NatArith.Add(18446744073709551615, 18446744073709551615, n);
  Check.Fails("NatArith.Add", 18446744073709551615, ok);
  ok := NatArith.Mul(18446744073709551615, 18446744073709551615, n);
  Check.Fails("NatArith.Mul", 18446744073709551615, ok);
  Check.Nat("NatArith.Sub", 18446744073709551615, TRUE, NatArith.Sub(18446744073709551615, 18446744073709551615), 0);
  Check.Nat("NatArith.Div", 18446744073709551615, TRUE, NatArith.Div(18446744073709551615, 18446744073709551615), 1);
  Check.Nat("NatArith.Mod", 18446744073709551615, TRUE, NatArith.Mod(18446744073709551615, 18446744073709551615), 0);
  Check.Nat("NatArith.Dist", 18446744073709551615, TRUE, NatArith.Dist(18446744073709551615, 18446744073709551615), 0);
  Check.Nat("NatArith.Xor", 18446744073709551615, TRUE, NatArith.Xor(18446744073709551615, 18446744073709551615), 0);
  Check.Nat("NatArith.LAnd", 18446744073709551615, TRUE, NatArith.LAnd(18446744073709551615, 18446744073709551615), 18446744073709551615);
  Check.Nat("NatArith.LOr", 18446744073709551615, TRUE, NatArith.LOr(18446744073709551615, 18446744073709551615), 18446744073709551615);
  Check.True("NatArith.Dvd(18446744073709551615,18446744073709551615)", (NatArith.Dvd(18446744073709551615, 18446744073709551615)) = TRUE);
  ok := NatArith.Add(4294967296, 4294967296, n);
  Check.Nat("NatArith.Add", 4294967296, ok, n, 8589934592);
  ok := NatArith.Mul(4294967296, 4294967296, n);
  Check.Fails("NatArith.Mul", 4294967296, ok);
  Check.Nat("NatArith.Sub", 4294967296, TRUE, NatArith.Sub(4294967296, 4294967296), 0);
  Check.Nat("NatArith.Div", 4294967296, TRUE, NatArith.Div(4294967296, 4294967296), 1);
  Check.Nat("NatArith.Mod", 4294967296, TRUE, NatArith.Mod(4294967296, 4294967296), 0);
  Check.Nat("NatArith.Dist", 4294967296, TRUE, NatArith.Dist(4294967296, 4294967296), 0);
  Check.Nat("NatArith.Xor", 4294967296, TRUE, NatArith.Xor(4294967296, 4294967296), 0);
  Check.Nat("NatArith.LAnd", 4294967296, TRUE, NatArith.LAnd(4294967296, 4294967296), 4294967296);
  Check.Nat("NatArith.LOr", 4294967296, TRUE, NatArith.LOr(4294967296, 4294967296), 4294967296);
  Check.True("NatArith.Dvd(4294967296,4294967296)", (NatArith.Dvd(4294967296, 4294967296)) = TRUE);
  ok := NatArith.Add(4294967295, 4294967297, n);
  Check.Nat("NatArith.Add", 4294967295, ok, n, 8589934592);
  ok := NatArith.Mul(4294967295, 4294967297, n);
  Check.Nat("NatArith.Mul", 4294967295, ok, n, 18446744073709551615);
  Check.Nat("NatArith.Sub", 4294967295, TRUE, NatArith.Sub(4294967295, 4294967297), 0);
  Check.Nat("NatArith.Div", 4294967295, TRUE, NatArith.Div(4294967295, 4294967297), 0);
  Check.Nat("NatArith.Mod", 4294967295, TRUE, NatArith.Mod(4294967295, 4294967297), 4294967295);
  Check.Nat("NatArith.Dist", 4294967295, TRUE, NatArith.Dist(4294967295, 4294967297), 2);
  Check.Nat("NatArith.Xor", 4294967295, TRUE, NatArith.Xor(4294967295, 4294967297), 8589934590);
  Check.Nat("NatArith.LAnd", 4294967295, TRUE, NatArith.LAnd(4294967295, 4294967297), 1);
  Check.Nat("NatArith.LOr", 4294967295, TRUE, NatArith.LOr(4294967295, 4294967297), 8589934591);
  Check.True("NatArith.Dvd(4294967295,4294967297)", (NatArith.Dvd(4294967295, 4294967297)) = FALSE);
  ok := NatArith.Pow(0, 0, n);
  Check.Nat("NatArith.Pow", 0, ok, n, 1);
  ok := NatArith.Pow(0, 3, n);
  Check.Nat("NatArith.Pow", 0, ok, n, 0);
  ok := NatArith.Pow(1, 1000000000000000000, n);
  Check.Nat("NatArith.Pow", 1, ok, n, 1);
  ok := NatArith.Pow(2, 63, n);
  Check.Nat("NatArith.Pow", 2, ok, n, 9223372036854775808);
  ok := NatArith.Pow(2, 64, n);
  Check.Fails("NatArith.Pow", 2, ok);
  ok := NatArith.Pow(3, 40, n);
  Check.Nat("NatArith.Pow", 3, ok, n, 12157665459056928801);
  ok := NatArith.Pow(3, 41, n);
  Check.Fails("NatArith.Pow", 3, ok);
  ok := NatArith.Pow(10, 19, n);
  Check.Nat("NatArith.Pow", 10, ok, n, 10000000000000000000);
  ok := NatArith.Pow(10, 20, n);
  Check.Fails("NatArith.Pow", 10, ok);
  ok := NatArith.Pow(18446744073709551615, 1, n);
  Check.Nat("NatArith.Pow", 18446744073709551615, ok, n, 18446744073709551615);
  Check.Nat("NatArith.Sqrt", 0, TRUE, NatArith.Sqrt(0), 0);
  Check.True("NatArith.IsSquare(0)", (NatArith.IsSquare(0)) = TRUE);
  Check.Nat("NatArith.Log2", 0, TRUE, NatArith.Log2(0), 0);
  Check.Nat("NatArith.PopCount", 0, TRUE, NatArith.PopCount(0), 0);
  Check.Nat("NatArith.Pred", 0, TRUE, NatArith.Pred(0), 0);
  Check.Nat("NatArith.Sqrt", 1, TRUE, NatArith.Sqrt(1), 1);
  Check.True("NatArith.IsSquare(1)", (NatArith.IsSquare(1)) = TRUE);
  Check.Nat("NatArith.Log2", 1, TRUE, NatArith.Log2(1), 0);
  Check.Nat("NatArith.PopCount", 1, TRUE, NatArith.PopCount(1), 1);
  Check.Nat("NatArith.Pred", 1, TRUE, NatArith.Pred(1), 0);
  Check.Nat("NatArith.Sqrt", 2, TRUE, NatArith.Sqrt(2), 1);
  Check.True("NatArith.IsSquare(2)", (NatArith.IsSquare(2)) = FALSE);
  Check.Nat("NatArith.Log2", 2, TRUE, NatArith.Log2(2), 1);
  Check.Nat("NatArith.PopCount", 2, TRUE, NatArith.PopCount(2), 1);
  Check.Nat("NatArith.Pred", 2, TRUE, NatArith.Pred(2), 1);
  Check.Nat("NatArith.Sqrt", 3, TRUE, NatArith.Sqrt(3), 1);
  Check.True("NatArith.IsSquare(3)", (NatArith.IsSquare(3)) = FALSE);
  Check.Nat("NatArith.Log2", 3, TRUE, NatArith.Log2(3), 1);
  Check.Nat("NatArith.PopCount", 3, TRUE, NatArith.PopCount(3), 2);
  Check.Nat("NatArith.Pred", 3, TRUE, NatArith.Pred(3), 2);
  Check.Nat("NatArith.Sqrt", 4, TRUE, NatArith.Sqrt(4), 2);
  Check.True("NatArith.IsSquare(4)", (NatArith.IsSquare(4)) = TRUE);
  Check.Nat("NatArith.Log2", 4, TRUE, NatArith.Log2(4), 2);
  Check.Nat("NatArith.PopCount", 4, TRUE, NatArith.PopCount(4), 1);
  Check.Nat("NatArith.Pred", 4, TRUE, NatArith.Pred(4), 3);
  Check.Nat("NatArith.Sqrt", 15, TRUE, NatArith.Sqrt(15), 3);
  Check.True("NatArith.IsSquare(15)", (NatArith.IsSquare(15)) = FALSE);
  Check.Nat("NatArith.Log2", 15, TRUE, NatArith.Log2(15), 3);
  Check.Nat("NatArith.PopCount", 15, TRUE, NatArith.PopCount(15), 4);
  Check.Nat("NatArith.Pred", 15, TRUE, NatArith.Pred(15), 14);
  Check.Nat("NatArith.Sqrt", 16, TRUE, NatArith.Sqrt(16), 4);
  Check.True("NatArith.IsSquare(16)", (NatArith.IsSquare(16)) = TRUE);
  Check.Nat("NatArith.Log2", 16, TRUE, NatArith.Log2(16), 4);
  Check.Nat("NatArith.PopCount", 16, TRUE, NatArith.PopCount(16), 1);
  Check.Nat("NatArith.Pred", 16, TRUE, NatArith.Pred(16), 15);
  Check.Nat("NatArith.Sqrt", 17, TRUE, NatArith.Sqrt(17), 4);
  Check.True("NatArith.IsSquare(17)", (NatArith.IsSquare(17)) = FALSE);
  Check.Nat("NatArith.Log2", 17, TRUE, NatArith.Log2(17), 4);
  Check.Nat("NatArith.PopCount", 17, TRUE, NatArith.PopCount(17), 2);
  Check.Nat("NatArith.Pred", 17, TRUE, NatArith.Pred(17), 16);
  Check.Nat("NatArith.Sqrt", 99, TRUE, NatArith.Sqrt(99), 9);
  Check.True("NatArith.IsSquare(99)", (NatArith.IsSquare(99)) = FALSE);
  Check.Nat("NatArith.Log2", 99, TRUE, NatArith.Log2(99), 6);
  Check.Nat("NatArith.PopCount", 99, TRUE, NatArith.PopCount(99), 4);
  Check.Nat("NatArith.Pred", 99, TRUE, NatArith.Pred(99), 98);
  Check.Nat("NatArith.Sqrt", 1000000000000, TRUE, NatArith.Sqrt(1000000000000), 1000000);
  Check.True("NatArith.IsSquare(1000000000000)", (NatArith.IsSquare(1000000000000)) = TRUE);
  Check.Nat("NatArith.Log2", 1000000000000, TRUE, NatArith.Log2(1000000000000), 39);
  Check.Nat("NatArith.PopCount", 1000000000000, TRUE, NatArith.PopCount(1000000000000), 13);
  Check.Nat("NatArith.Pred", 1000000000000, TRUE, NatArith.Pred(1000000000000), 999999999999);
  Check.Nat("NatArith.Sqrt", 1000000000001, TRUE, NatArith.Sqrt(1000000000001), 1000000);
  Check.True("NatArith.IsSquare(1000000000001)", (NatArith.IsSquare(1000000000001)) = FALSE);
  Check.Nat("NatArith.Log2", 1000000000001, TRUE, NatArith.Log2(1000000000001), 39);
  Check.Nat("NatArith.PopCount", 1000000000001, TRUE, NatArith.PopCount(1000000000001), 14);
  Check.Nat("NatArith.Pred", 1000000000001, TRUE, NatArith.Pred(1000000000001), 1000000000000);
  Check.Nat("NatArith.Sqrt", 18446744073709551615, TRUE, NatArith.Sqrt(18446744073709551615), 4294967295);
  Check.True("NatArith.IsSquare(18446744073709551615)", (NatArith.IsSquare(18446744073709551615)) = FALSE);
  Check.Nat("NatArith.Log2", 18446744073709551615, TRUE, NatArith.Log2(18446744073709551615), 63);
  Check.Nat("NatArith.PopCount", 18446744073709551615, TRUE, NatArith.PopCount(18446744073709551615), 64);
  Check.Nat("NatArith.Pred", 18446744073709551615, TRUE, NatArith.Pred(18446744073709551615), 18446744073709551614);
  Check.Nat("NatArith.Sqrt", 4611686018427387904, TRUE, NatArith.Sqrt(4611686018427387904), 2147483648);
  Check.True("NatArith.IsSquare(4611686018427387904)", (NatArith.IsSquare(4611686018427387904)) = TRUE);
  Check.Nat("NatArith.Log2", 4611686018427387904, TRUE, NatArith.Log2(4611686018427387904), 62);
  Check.Nat("NatArith.PopCount", 4611686018427387904, TRUE, NatArith.PopCount(4611686018427387904), 1);
  Check.Nat("NatArith.Pred", 4611686018427387904, TRUE, NatArith.Pred(4611686018427387904), 4611686018427387903);
  Check.Nat("NatArith.Log", 5, TRUE, NatArith.Log(0, 5), 0);
  Check.Nat("NatArith.Clog", 5, TRUE, NatArith.Clog(0, 5), 0);
  Check.Nat("NatArith.Log", 5, TRUE, NatArith.Log(1, 5), 0);
  Check.Nat("NatArith.Clog", 5, TRUE, NatArith.Clog(1, 5), 0);
  Check.Nat("NatArith.Log", 0, TRUE, NatArith.Log(2, 0), 0);
  Check.Nat("NatArith.Clog", 0, TRUE, NatArith.Clog(2, 0), 0);
  Check.Nat("NatArith.Log", 1, TRUE, NatArith.Log(2, 1), 0);
  Check.Nat("NatArith.Clog", 1, TRUE, NatArith.Clog(2, 1), 0);
  Check.Nat("NatArith.Log", 1023, TRUE, NatArith.Log(2, 1023), 9);
  Check.Nat("NatArith.Clog", 1023, TRUE, NatArith.Clog(2, 1023), 10);
  Check.Nat("NatArith.Log", 1024, TRUE, NatArith.Log(2, 1024), 10);
  Check.Nat("NatArith.Clog", 1024, TRUE, NatArith.Clog(2, 1024), 10);
  Check.Nat("NatArith.Log", 999, TRUE, NatArith.Log(10, 999), 2);
  Check.Nat("NatArith.Clog", 999, TRUE, NatArith.Clog(10, 999), 3);
  Check.Nat("NatArith.Log", 1000, TRUE, NatArith.Log(10, 1000), 3);
  Check.Nat("NatArith.Clog", 1000, TRUE, NatArith.Clog(10, 1000), 3);
  Check.Nat("NatArith.Log", 18446744073709551615, TRUE, NatArith.Log(10, 18446744073709551615), 19);
  Check.Nat("NatArith.Clog", 18446744073709551615, TRUE, NatArith.Clog(10, 18446744073709551615), 20);
  Check.Nat("NatArith.Log", 9223372036854775808, TRUE, NatArith.Log(3, 9223372036854775808), 39);
  Check.Nat("NatArith.Clog", 9223372036854775808, TRUE, NatArith.Clog(3, 9223372036854775808), 40);
  Check.Nat("NatArith.Log", 1, TRUE, NatArith.Log(7, 1), 0);
  Check.Nat("NatArith.Clog", 1, TRUE, NatArith.Clog(7, 1), 0);
  ok := NatArith.ShiftLeft(1, 0, n);
  Check.Nat("NatArith.ShiftLeft", 1, ok, n, 1);
  ok := NatArith.ShiftLeft(1, 63, n);
  Check.Nat("NatArith.ShiftLeft", 1, ok, n, 9223372036854775808);
  ok := NatArith.ShiftLeft(1, 64, n);
  Check.Fails("NatArith.ShiftLeft", 1, ok);
  ok := NatArith.ShiftLeft(3, 62, n);
  Check.Nat("NatArith.ShiftLeft", 3, ok, n, 13835058055282163712);
  ok := NatArith.ShiftLeft(3, 63, n);
  Check.Fails("NatArith.ShiftLeft", 3, ok);
  ok := NatArith.ShiftLeft(0, 100, n);
  Check.Nat("NatArith.ShiftLeft", 0, ok, n, 0);
  ok := NatArith.ShiftLeft(18446744073709551615, 0, n);
  Check.Nat("NatArith.ShiftLeft", 18446744073709551615, ok, n, 18446744073709551615);
  Check.Nat("NatArith.ShiftRight", 18446744073709551615, TRUE, NatArith.ShiftRight(18446744073709551615, 0), 18446744073709551615);
  Check.Nat("NatArith.ShiftRight", 18446744073709551615, TRUE, NatArith.ShiftRight(18446744073709551615, 63), 1);
  Check.Nat("NatArith.ShiftRight", 18446744073709551615, TRUE, NatArith.ShiftRight(18446744073709551615, 64), 0);
  Check.Nat("NatArith.ShiftRight", 18446744073709551615, TRUE, NatArith.ShiftRight(18446744073709551615, 1000), 0);
  Check.Nat("NatArith.ShiftRight", 12345, TRUE, NatArith.ShiftRight(12345, 3), 1543);
  Check.True("NatArith.TestBit(5,0)", (NatArith.TestBit(5, 0)) = TRUE);
  Check.True("NatArith.TestBit(5,1)", (NatArith.TestBit(5, 1)) = FALSE);
  Check.True("NatArith.TestBit(5,2)", (NatArith.TestBit(5, 2)) = TRUE);
  Check.True("NatArith.TestBit(9223372036854775808,63)", (NatArith.TestBit(9223372036854775808, 63)) = TRUE);
  Check.True("NatArith.TestBit(9223372036854775808,64)", (NatArith.TestBit(9223372036854775808, 64)) = FALSE);
  Check.True("NatArith.TestBit(18446744073709551615,1000)", (NatArith.TestBit(18446744073709551615, 1000)) = FALSE);
  Check.Nat("NumberTheory.Gcd", 0, TRUE, NumberTheory.Gcd(0, 0), 0);
  ok := NumberTheory.Lcm(0, 0, n);
  Check.Nat("NumberTheory.Lcm", 0, ok, n, 0);
  Check.True("NumberTheory.Coprime(0,0)", (NumberTheory.Coprime(0, 0)) = FALSE);
  Check.Nat("NumberTheory.Gcd", 0, TRUE, NumberTheory.Gcd(0, 9), 9);
  ok := NumberTheory.Lcm(0, 9, n);
  Check.Nat("NumberTheory.Lcm", 0, ok, n, 0);
  Check.True("NumberTheory.Coprime(0,9)", (NumberTheory.Coprime(0, 9)) = FALSE);
  Check.Nat("NumberTheory.Gcd", 12, TRUE, NumberTheory.Gcd(12, 18), 6);
  ok := NumberTheory.Lcm(12, 18, n);
  Check.Nat("NumberTheory.Lcm", 12, ok, n, 36);
  Check.True("NumberTheory.Coprime(12,18)", (NumberTheory.Coprime(12, 18)) = FALSE);
  Check.Nat("NumberTheory.Gcd", 17, TRUE, NumberTheory.Gcd(17, 31), 1);
  ok := NumberTheory.Lcm(17, 31, n);
  Check.Nat("NumberTheory.Lcm", 17, ok, n, 527);
  Check.True("NumberTheory.Coprime(17,31)", (NumberTheory.Coprime(17, 31)) = TRUE);
